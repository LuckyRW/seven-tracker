{
  "name": "seven-tracker",
  "version": "0.20.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "oss!idle add-on: records every 7K play as it finishes, works out base XP per second per map and rate, rules rates out, and builds playlists that test what is left.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckyRW/seven-tracker.git"
  },
  "scripts": {
    "build": "node ./scripts/build-addon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/seven-test.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/message-utils": "^5.9.5",
    "@oss-idle/addon-sdk": "^0.9.0",
    "oss-idle": "https://codeload.github.com/oss-idle/oss-idle/tar.gz/85b5200ebe9831650864a09a423483b627380f58"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "sql.js": "^1.15.1",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  }
}
